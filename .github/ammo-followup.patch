+#[test]
+fn legacy_worker_remembers_inherited_profile_on_cold_reload_without_rotating() {
+    let policy = TeammatePolicy::default();
+    let profiles = csv("ammo1,ammo3");
+    assert_eq!(policy.select_profile("name:champion", true, &profiles, None), Some("ammo1".to_string()));
+    assert_eq!(policy.select_profile("name:worker", false, &profiles, Some("ammo1")), Some("ammo1".to_string()));
+    assert_eq!(policy.select_profile("name:worker", false, &profiles, Some("chief")), Some("ammo1".to_string()));
+    assert_eq!(policy.select_profile("name:other", true, &profiles, None), Some("ammo3".to_string()));
+    assert_eq!(policy.select_profile("name:unknown", false, &profiles, Some("chief")), None);
+}
